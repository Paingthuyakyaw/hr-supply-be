DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

# Cloudflare R2 upload
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket-name"
R2_PUBLIC_BASE_URL="https://your-public-r2-domain-or-r2-dev-url"
R2_PRESIGN_EXPIRES_IN="300"

# n8n onboarding integration
# N8N_ONBOARDING_WEBHOOK_URL="http://localhost:5678/webhook/employee-created"
N8N_ONBOARDING_WEBHOOK_URL="http://localhost:5678/webhook-test/employe-create"
N8N_ONBOARDING_SECRET="replace-with-a-strong-shared-secret"
ONBOARDING_PROBATION_DAYS="90"
ONBOARDING_WEBHOOK_TIMEOUT_MS="5000"
ONBOARDING_SETUP_LINK_BASE_URL="http://localhost:5173/setup-account"

